{
    "compilerOptions": {
        "jsx": "react",
        "module": "ESNext",
        "moduleResolution": "Node",
        "paths": {
            "~*": ["./*"]
        },
        "allowJs": true,
        "checkJs": false,
        "strict": true,
        "target": "ES2017",
        "allowSyntheticDefaultImports": true,
        "ignoreDeprecations": "6.0",
        "skipLibCheck": true,
        "types": ["vite/client"]
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
